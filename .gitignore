# Rust build cache (regenerate with cargo build)
crypto_core/target/

# Xcode / tuist generated project files (regenerate with `tuist generate`)
App/build/
App/Derived/
App/CryptoCoreApp.xcodeproj/
App/CryptoCoreApp.xcworkspace/
App/.tuist-bin/
App/Tuist/.build/

# SDKBuild: the throwaway project used to compile CryptoCoreKit into a
# closed-source .xcframework (regenerate with `tuist generate`). Its output
# copy of the xcframework is intermediate — the tracked copy that actually
# gets distributed lives in CryptoCoreKitSDK/.
SDKBuild/build/
SDKBuild/Derived/
SDKBuild/CryptoCoreKitSDKBuild.xcodeproj/
SDKBuild/CryptoCoreKitSDKBuild.xcworkspace/
SDKBuild/CryptoCoreKit.xcframework/

# CryptoCoreKitSDK: the distributable SPM package. CryptoCoreKit.xcframework
# itself IS tracked (it's the whole point — a closed-source binary package),
# only SPM's own local resolution cache is ignored.
CryptoCoreKitSDK/.build/

# ElizaProtoKit: the "backend team's proto contract" package. .tools holds a
# locally-built protoc-gen-swift binary pinned to the exact swift-protobuf
# version this package depends on (see README — Tuist can't run SPM build
# tool plugins from external packages, so Sources/ElizaProtoKit/Generated is
# committed and regenerated by hand instead of at build time).
ElizaProtoKit/.build/
ElizaProtoKit/.tools/
ElizaProtoKit/Derived/
ElizaProtoKit/ElizaProtoKit.xcodeproj/

# macOS
.DS_Store
